# Integration stack — copy to .env.integrations or merge with .env
# docker compose --env-file .env.integrations -f docker-compose.yml -f docker-compose.integrations.yml up -d --build

CRM_ADAPTER=bitrix
ACCOUNTING_ADAPTER=onec
BITRIX_WEBHOOK_URL=http://localhost:8091/rest/1/devtoken
BITRIX_INBOUND_TOKEN=dev-bitrix-inbound
ONEC_BASE_URL=http://localhost:8092/accounting

# Optional: basic auth on mock-onec (set same on mock-onec service + ONEC_USERNAME/PASSWORD here)
# MOCK_ONEC_USERNAME=onec
# MOCK_ONEC_PASSWORD=secret
# ONEC_USERNAME=onec
# ONEC_PASSWORD=secret
