APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://polomnik:polomnik@localhost:5432/polomnik?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ADMIN_TOKEN=dev-admin-token
JWT_SECRET=dev-jwt-secret-change-me
INTERNAL_API_SECRET=dev-internal-api-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=info
CRM_ADAPTER=noop
ACCOUNTING_ADAPTER=noop
