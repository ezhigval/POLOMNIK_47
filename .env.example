UPLOAD_PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_MAX_BYTES=5242880
WORKER_HEARTBEAT_PATH=/tmp/polomnik-worker-heartbeat
WORKER_HEARTBEAT_MAX_AGE=2m
