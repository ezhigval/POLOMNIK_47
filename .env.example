# Local / example env. Copy to .env (gitignored). Production: .env.production.example → .env.production on the VM.
# Never commit secrets. Names only. See docs/V4_OWNER_SETUP.md, docs/V2_OWNER_SETUP.md, docs/V3_OWNER_SETUP.md.

APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://palomnik:palomnik@localhost:5432/palomnik?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ADMIN_TOKEN=dev-admin-token
JWT_SECRET=dev-jwt-secret-change-me
INTERNAL_API_SECRET=dev-internal-api-secret
LOG_LEVEL=info
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SHUTDOWN_TIMEOUT=10s
OUTBOX_WORKER_POLL_INTERVAL=30s
OUTBOX_WORKER_BATCH_SIZE=10
OUTBOX_WORKER_MAX_ATTEMPTS=5
UPLOAD_DIR=./data/uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_MAX_BYTES=5242880
WORKER_HEARTBEAT_PATH=/tmp/palomnik-worker-heartbeat
WORKER_HEARTBEAT_MAX_AGE=2m
PUBLIC_SITE_URL=https://tikhvin-palomnik.ru
MANAGEMENT_BASE_URL=http://localhost:3000/management/bookings

# --- Notifications (Telegram live on prod; local default noop) ---
# docs/TELEGRAM_SETUP.md
NOTIFICATION_ADAPTER=noop
# NOTIFICATION_ADAPTER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_WEBHOOK_URL=
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=

# --- Phone: sms.ru callcheck (not SMS OTP). docs/V2_OWNER_SETUP.md ---
PHONE_ADAPTER=noop
# PHONE_ADAPTER=smsru
SMSRU_API_ID=

# --- Mail. docs/V2_OWNER_SETUP.md. Non-secret forward list can also live in admin «Настройки». ---
MAIL_ADAPTER=noop
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_FORWARD_TO=

# --- Social OAuth (frontend + api). Redirects on the site, not api.*. docs/OAUTH_SETUP.md ---
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
MAX_OAUTH_CLIENT_ID=
MAX_OAUTH_CLIENT_SECRET=
MAX_OAUTH_AUTHORIZE_URL=
MAX_OAUTH_TOKEN_URL=
MAX_OAUTH_USERINFO_URL=

# --- Bitrix24 / 1C: keep noop unless the owner asks live. docs/BITRIX_SETUP.md ---
CRM_ADAPTER=noop
ACCOUNTING_ADAPTER=noop
# BITRIX_WEBHOOK_URL=
# BITRIX_ORIGINATOR_ID=palomnik
# BITRIX_INBOUND_TOKEN=
# ONEC_BASE_URL=
# Local mocks: docker compose -f docker-compose.yml -f docker-compose.integrations.yml up -d --build
# see .env.integrations.example

# --- v3 adapters: without a key Configured()==false, site stays up. docs/V3_OWNER_SETUP.md ---
CAPTCHA_ADAPTER=noop
# CAPTCHA_ADAPTER=smartcaptcha
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_CLIENT_KEY=

BACKUP_STORAGE_ADAPTER=noop
# BACKUP_STORAGE_ADAPTER=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=palomnik-backups
BACKUP_LAST_PATH=./backups/last-backup.json

MESSENGER_ADAPTER=noop
# MESSENGER_ADAPTER=telegram  # same TELEGRAM_BOT_TOKEN + TELEGRAM_API_BASE (Worker URL in production)
# MESSENGER_ADAPTER=max
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
# MESSENGER_ADAPTER=whatsapp  # official Cloud API only
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_BASE=https://graph.facebook.com/v21.0

PUBLISHER_ADAPTER=noop
# PUBLISHER_ADAPTER=live  # or site_news / telegram_channel / vk_wall / max_feed
TELEGRAM_CHANNEL_ID=
VK_WALL_TOKEN=
VK_WALL_OWNER_ID=
VK_API_BASE=https://api.vk.com
VK_API_VERSION=5.199
MAX_FEED_CHAT_ID=

AI_ADAPTER=noop
# AI_ADAPTER=yandexgpt
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt-lite
YANDEXGPT_API_BASE=https://llm.api.cloud.yandex.net

# PaymentPort: live acquiring off until owner confirms AWAITING_PAYMENT / PAID. Keep noop.
PAYMENT_ADAPTER=noop
# PAYMENT_ADAPTER=sber
SBER_USERNAME=
SBER_PASSWORD=
SBER_API_BASE=https://securepayments.sberbank.ru
# PAYMENT_ADAPTER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE=https://api.yookassa.ru
PAYMENT_RETURN_URL=

# --- Operator PD (legal). Empty = code placeholders. Do not invent INN/OGRN. docs/legal/README.md ---
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_OGRN=
OPERATOR_LEGAL_ADDRESS=
OPERATOR_ACTUAL_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
