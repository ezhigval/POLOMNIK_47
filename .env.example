APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://palomnik:palomnik@localhost:5432/palomnik?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ADMIN_TOKEN=dev-admin-token
JWT_SECRET=dev-jwt-secret-change-me
INTERNAL_API_SECRET=dev-internal-api-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=info
CRM_ADAPTER=noop
ACCOUNTING_ADAPTER=noop
# CRM_ADAPTER=bitrix
# BITRIX_WEBHOOK_URL=
# BITRIX_ORIGINATOR_ID=palomnik
# BITRIX_DEAL_CATEGORY_ID=0
# BITRIX_STAGE_NEW=
# BITRIX_STAGE_CONTACTED=
# BITRIX_STAGE_CONFIRMED=
# BITRIX_STAGE_COMPLETED=
# BITRIX_STAGE_CANCELLED=
# BITRIX_UF_TOUR_ID=
# BITRIX_UF_PEOPLE_COUNT=
# ACCOUNTING_ADAPTER=onec
# ONEC_BASE_URL=
# ONEC_EXPORT_BOOKING_PATH=/hs/palomnik/booking
# ONEC_COUNTERPARTY_PATH=/hs/palomnik/counterparty
# ONEC_USERNAME=
# ONEC_PASSWORD=
# ONEC_API_KEY=
# Integrations (local mocks)
# docker compose -f docker-compose.yml -f docker-compose.integrations.yml up -d --build
# CRM_ADAPTER=bitrix
# ACCOUNTING_ADAPTER=onec
# BITRIX_WEBHOOK_URL=http://localhost:8091/rest/1/devtoken
# BITRIX_INBOUND_TOKEN=dev-bitrix-inbound
# ONEC_BASE_URL=http://localhost:8092/accounting
# ONEC_PROTOCOL=http
# ONEC_PROTOCOL=odata
# ONEC_ODATA_PATH=/odata/standard.odata
# ONEC_ODATA_COUNTERPARTY=Catalog_Контрагенты
# ONEC_ODATA_SALES_ORDER=Document_ЗаказКлиента
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SHUTDOWN_TIMEOUT=10s
OUTBOX_WORKER_POLL_INTERVAL=30s
OUTBOX_WORKER_BATCH_SIZE=10
OUTBOX_WORKER_MAX_ATTEMPTS=5
NOTIFICATION_ADAPTER=noop
# NOTIFICATION_ADAPTER=telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_CHAT_ID=
# MANAGEMENT_BASE_URL=http://localhost:3000/management/bookings
# TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_LOGIN_BOT_TOKEN=
# TELEGRAM_LOGIN_BOT_USERNAME=
UPLOAD_DIR=./data/uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_MAX_BYTES=5242880
WORKER_HEARTBEAT_PATH=/tmp/palomnik-worker-heartbeat
WORKER_HEARTBEAT_MAX_AGE=2m

# Phone verification via sms.ru callcheck (user calls a provided number — not SMS OTP).
# PHONE_ADAPTER=smsru (aliases: call, callcheck). SMS_ADAPTER is a legacy alias for PHONE_ADAPTER.
PHONE_ADAPTER=noop
# SMSRU_API_ID=


# Mail (noop until MAIL_ADAPTER=smtp)
MAIL_ADAPTER=noop
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_FORWARD_TO=

# Social OAuth (frontend + api)
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
MAX_OAUTH_CLIENT_ID=
MAX_OAUTH_CLIENT_SECRET=
MAX_OAUTH_AUTHORIZE_URL=
MAX_OAUTH_TOKEN_URL=
MAX_OAUTH_USERINFO_URL=
PUBLIC_SITE_URL=https://tikhvin-palomnik.ru

# v3 platform — adapters stay noop until a key exists
CAPTCHA_ADAPTER=noop
# CAPTCHA_ADAPTER=smartcaptcha
# SMARTCAPTCHA_SERVER_KEY=
# SMARTCAPTCHA_CLIENT_KEY=
BACKUP_STORAGE_ADAPTER=noop
# BACKUP_STORAGE_ADAPTER=s3
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PREFIX=palomnik-backups
BACKUP_LAST_PATH=./backups/last-backup.json

# v3 stage 4 — MessengerPort (chats/bot UX is stage 5; without a key the adapter is noop)
MESSENGER_ADAPTER=noop
# MESSENGER_ADAPTER=telegram
# uses TELEGRAM_BOT_TOKEN + TELEGRAM_API_BASE (Worker URL in production)
# MESSENGER_ADAPTER=max
# MAX_BOT_TOKEN=
# MAX_API_BASE=https://platform-api2.max.ru
# MESSENGER_ADAPTER=whatsapp
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_BASE=https://graph.facebook.com/v21.0

# v3 stage 4 — PublisherPort (SMM calendar UX is stage 6; without a key the adapter is noop)
PUBLISHER_ADAPTER=noop
# PUBLISHER_ADAPTER=live
#   live routes Publish(channel) to whichever of site_news / telegram_channel / vk_wall / max_feed has credentials
# PUBLISHER_ADAPTER=site_news
# PUBLISHER_ADAPTER=telegram_channel
# TELEGRAM_CHANNEL_ID=
#   uses TELEGRAM_BOT_TOKEN + TELEGRAM_API_BASE (Worker URL in production); bot must be channel admin
# PUBLISHER_ADAPTER=vk_wall
# VK_WALL_TOKEN=
# VK_WALL_OWNER_ID=
#   community owner_id is negative, e.g. -123456
# VK_API_BASE=https://api.vk.com
# VK_API_VERSION=5.199
# PUBLISHER_ADAPTER=max_feed
# MAX_FEED_CHAT_ID=
#   uses MAX_BOT_TOKEN + MAX_API_BASE

