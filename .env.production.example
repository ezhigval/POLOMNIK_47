# Production environment — copy to .env.production and fill before deploy.
# docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# Domains (DNS A-records → server IP)
SITE_DOMAIN=polomnik47.ru
API_DOMAIN=api.polomnik47.ru
ACME_EMAIL=admin@polomnik47.ru

# PostgreSQL (change from dev defaults!)
POSTGRES_DB=polomnik
POSTGRES_USER=polomnik
POSTGRES_PASSWORD=change-me-strong-db-password

# API secrets (generate random strings ≥32 chars)
APP_ENV=production
ADMIN_TOKEN=change-me-admin-token-min-16-chars
JWT_SECRET=change-me-jwt-secret-min-32-characters-long
INTERNAL_API_SECRET=change-me-internal-secret-min-16

# CORS — public site origin only
CORS_ALLOW_ORIGINS=https://polomnik47.ru

# Frontend public URLs (must match Caddy domains)
NEXT_PUBLIC_SITE_URL=https://polomnik47.ru
NEXT_PUBLIC_API_URL=https://api.polomnik47.ru/api/v1
UPLOAD_PUBLIC_BASE_URL=https://api.polomnik47.ru
NEXT_PUBLIC_CONTACT_PHONE=+78000000000
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=8 (800) 000-00-00
NEXT_PUBLIC_CONTACT_EMAIL=info@polomnik47.ru
NEXT_PUBLIC_SITE_NAME=POLOMNIK 47
NEXT_PUBLIC_SITE_TAGLINE=Паломническая служба

# Analytics (optional, Stage E)
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notifications (Stage E)
NOTIFICATION_ADAPTER=noop
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MANAGEMENT_BASE_URL=https://polomnik47.ru/management/bookings

# Integrations (Stage E — live credentials)
CRM_ADAPTER=noop
ACCOUNTING_ADAPTER=noop
BITRIX_WEBHOOK_URL=
BITRIX_INBOUND_TOKEN=
ONEC_BASE_URL=
# Local mocks: see .env.integrations.example + docker-compose.integrations.yml
