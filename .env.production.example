# Production environment — copy to .env.production and fill before deploy.
# docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# Domains (DNS A-records → server IP)
SITE_DOMAIN=tikhvin-palomnik.ru
API_DOMAIN=api.tikhvin-palomnik.ru
ACME_EMAIL=smailikin70@yandex.ru

# PostgreSQL (change password from dev defaults!)
# New installs can use these names. On a live server keep POSTGRES_USER / POSTGRES_DB
# from the existing .env.production — do not rename the role inside an initialized volume.
POSTGRES_DB=palomnik
POSTGRES_USER=palomnik
POSTGRES_PASSWORD=change-me-strong-db-password

# API secrets (generate random strings ≥32 chars)
APP_ENV=production
ADMIN_TOKEN=change-me-admin-token-min-11-chars
JWT_SECRET=change-me-jwt-secret-min-32-characters-long
INTERNAL_API_SECRET=change-me-internal-secret-min-16

# CORS — canonical public origin (www redirects to apex)
CORS_ALLOW_ORIGINS=https://tikhvin-palomnik.ru

# Frontend public URLs (canonical production; /api/v1 is same-origin via Next rewrite)
NEXT_PUBLIC_SITE_URL=https://tikhvin-palomnik.ru
NEXT_PUBLIC_API_URL=/api/v1
UPLOAD_PUBLIC_BASE_URL=https://api.tikhvin-palomnik.ru
NEXT_PUBLIC_CONTACT_PHONE=+79669334321
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+7 966 933-43-21
NEXT_PUBLIC_CONTACT_EMAIL=info@tikhvin-palomnik.ru
NEXT_PUBLIC_SITE_NAME=Тихвинский путь
NEXT_PUBLIC_SITE_FULL_NAME=РПЦ Тихвинская Епархия. Паломническая служба «Под покровом Божией Матери «Тихвинская»»
NEXT_PUBLIC_SITE_TAGLINE=Паломническая служба

# Analytics (optional) — empty = no scripts. See docs/SEO_ADS.md
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_YM_WEBVISOR=1
# NEXT_PUBLIC_YM_CLICKMAP=0

# Google OAuth — скрыт в UI (ROADMAP I.5); не включать без просьбы владельца
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Notifications (Stage E)
NOTIFICATION_ADAPTER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
# On the VM Telegram is blocked; copy TELEGRAM_API_BASE from the live .env.production (Cloudflare Worker).
TELEGRAM_API_BASE=
TELEGRAM_WEBHOOK_URL=https://api.tikhvin-palomnik.ru/api/v1/webhooks/telegram
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=
MANAGEMENT_BASE_URL=https://tikhvin-palomnik.ru/management/bookings

# Phone callcheck (sms.ru) — подтверждение звонком с номера клиента, не SMS
PHONE_ADAPTER=noop
# PHONE_ADAPTER=smsru
SMSRU_API_ID=

# Social OAuth (см. docs/OAUTH_SETUP.md) — без значений кнопки недоступны
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
MAX_OAUTH_CLIENT_ID=
MAX_OAUTH_CLIENT_SECRET=
MAX_OAUTH_AUTHORIZE_URL=
MAX_OAUTH_TOKEN_URL=
MAX_OAUTH_USERINFO_URL=

# Integrations (Stage E — live credentials)
CRM_ADAPTER=noop
ACCOUNTING_ADAPTER=noop
BITRIX_WEBHOOK_URL=
BITRIX_INBOUND_TOKEN=
ONEC_BASE_URL=
# Local mocks: see .env.integrations.example + docker-compose.integrations.yml

MAIL_ADAPTER=noop
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Fallback only when admin Settings mail-forward list is empty
MAIL_FORWARD_TO=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
MAX_OAUTH_CLIENT_ID=
MAX_OAUTH_CLIENT_SECRET=
MAX_OAUTH_AUTHORIZE_URL=
MAX_OAUTH_TOKEN_URL=
MAX_OAUTH_USERINFO_URL=
PUBLIC_SITE_URL=https://tikhvin-palomnik.ru

# v3 platform — without keys adapters stay noop, site stays up
CAPTCHA_ADAPTER=noop
# CAPTCHA_ADAPTER=smartcaptcha
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_CLIENT_KEY=
BACKUP_STORAGE_ADAPTER=noop
# BACKUP_STORAGE_ADAPTER=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=palomnik-backups
BACKUP_LAST_PATH=/tmp/palomnik-last-backup.json

# v3 stage 4 — stay noop until a key is pasted (see docs/V3_OWNER_SETUP.md)
MESSENGER_ADAPTER=noop
PUBLISHER_ADAPTER=noop
AI_ADAPTER=noop
PAYMENT_ADAPTER=noop
