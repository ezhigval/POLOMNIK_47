# Production environment — copy to .env.production on the VM and fill before deploy.
# docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Never commit .env.production. Names only. See docs/V4_OWNER_SETUP.md.

# Domains (DNS A-records → server IP)
SITE_DOMAIN=tikhvin-palomnik.ru
API_DOMAIN=api.tikhvin-palomnik.ru
ACME_EMAIL=smailikin70@yandex.ru

# PostgreSQL (change password from dev defaults!)
# New installs can use these names. On a live server keep POSTGRES_USER / POSTGRES_DB
# from the existing .env.production — do not rename the role inside an initialized volume.
POSTGRES_DB=palomnik
POSTGRES_USER=palomnik
POSTGRES_PASSWORD=change-me-strong-db-password

# API secrets (generate random strings ≥32 chars; ADMIN_TOKEN ≥11)
APP_ENV=production
ADMIN_TOKEN=change-me-admin-token-min-11-chars
JWT_SECRET=change-me-jwt-secret-min-32-characters-long
INTERNAL_API_SECRET=change-me-internal-secret-min-16

# CORS — canonical public origin (www redirects to apex)
CORS_ALLOW_ORIGINS=https://tikhvin-palomnik.ru

# Frontend public URLs (canonical production; /api/v1 is same-origin via Next rewrite)
NEXT_PUBLIC_SITE_URL=https://tikhvin-palomnik.ru
NEXT_PUBLIC_API_URL=/api/v1
UPLOAD_PUBLIC_BASE_URL=https://api.tikhvin-palomnik.ru
NEXT_PUBLIC_CONTACT_PHONE=+79669334321
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+7 966 933-43-21
NEXT_PUBLIC_CONTACT_EMAIL=info@tikhvin-palomnik.ru
NEXT_PUBLIC_SITE_NAME=Под Покровом Божией Матери "Тихвинская"
NEXT_PUBLIC_SITE_FULL_NAME=РПЦ Тихвинская Епархия. Паломническая служба «Под покровом Божией Матери «Тихвинская»»
NEXT_PUBLIC_SITE_TAGLINE=Паломническая служба
PUBLIC_SITE_URL=https://tikhvin-palomnik.ru

# Analytics — public Metrika counter. Empty YM_ID = no scripts. docs/SEO_ADS.md
# Prod counter is 111985266 (visible in page source). Do not put a second copy in admin.
NEXT_PUBLIC_YM_ID=111985266
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_WEBVISOR=1
# NEXT_PUBLIC_YM_CLICKMAP=0
# NEXT_PUBLIC_YANDEX_VERIFICATION=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google OAuth is hidden in UI — do not enable without an owner request.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Notifications. On the VM Telegram is blocked; copy TELEGRAM_API_BASE from the live .env.production (Cloudflare Worker).
# docs/TELEGRAM_SETUP.md
NOTIFICATION_ADAPTER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=
TELEGRAM_WEBHOOK_URL=https://api.tikhvin-palomnik.ru/api/v1/webhooks/telegram
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=
MANAGEMENT_BASE_URL=https://tikhvin-palomnik.ru/management/bookings

# Phone callcheck (sms.ru) — not SMS. docs/V2_OWNER_SETUP.md
PHONE_ADAPTER=noop
# PHONE_ADAPTER=smsru
SMSRU_API_ID=

# Social OAuth. Redirects on the site, not api.*. docs/OAUTH_SETUP.md
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
MAX_OAUTH_CLIENT_ID=
MAX_OAUTH_CLIENT_SECRET=
MAX_OAUTH_AUTHORIZE_URL=
MAX_OAUTH_TOKEN_URL=
MAX_OAUTH_USERINFO_URL=

# Mail. Non-secret forward addresses can also be set in admin «Настройки».
MAIL_ADAPTER=noop
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_FORWARD_TO=

# Bitrix24 / 1C — keep noop unless the owner asks live.
CRM_ADAPTER=noop
ACCOUNTING_ADAPTER=noop
BITRIX_WEBHOOK_URL=
BITRIX_INBOUND_TOKEN=
ONEC_BASE_URL=

# v3 adapters — without keys stay noop, site stays up. docs/V3_OWNER_SETUP.md
CAPTCHA_ADAPTER=noop
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_CLIENT_KEY=
BACKUP_STORAGE_ADAPTER=noop
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=palomnik-backups
BACKUP_LAST_PATH=/tmp/palomnik-last-backup.json

MESSENGER_ADAPTER=noop
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_BASE=https://graph.facebook.com/v21.0
PUBLISHER_ADAPTER=noop
TELEGRAM_CHANNEL_ID=
VK_WALL_TOKEN=
VK_WALL_OWNER_ID=
VK_API_BASE=https://api.vk.com
VK_API_VERSION=5.199
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
MAX_FEED_CHAT_ID=
AI_ADAPTER=noop
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt-lite
YANDEXGPT_API_BASE=https://llm.api.cloud.yandex.net

# PaymentPort: keep noop until owner confirms AWAITING_PAYMENT / PAID (not in domain yet).
PAYMENT_ADAPTER=noop
SBER_USERNAME=
SBER_PASSWORD=
SBER_API_BASE=https://securepayments.sberbank.ru
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE=https://api.yookassa.ru
PAYMENT_RETURN_URL=https://tikhvin-palomnik.ru/account/trips

# Operator PD. Empty = placeholders in code. Do not invent INN/OGRN. Compose now passes these through.
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_OGRN=
OPERATOR_LEGAL_ADDRESS=
OPERATOR_ACTUAL_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_INN=
NEXT_PUBLIC_OPERATOR_OGRN=
NEXT_PUBLIC_OPERATOR_LEGAL_ADDRESS=
NEXT_PUBLIC_OPERATOR_ACTUAL_ADDRESS=
NEXT_PUBLIC_OPERATOR_EMAIL=
NEXT_PUBLIC_OPERATOR_PHONE=
